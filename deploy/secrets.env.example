# /etc/insidelabel/secrets.env on the server (D-114): root:root, mode 0600.
# Read by systemd when it starts the service; never copied into the repo.
# Fill the values on the server only (DEPLOY.md, step 7).

# Gemini: reads the label (D-004: it reads, the rules judge).
GEMINI_API_KEY=

# Cloud Vision: the OCR cross-check (D-093). Without it the server quietly falls
# back to Tesseract, about 20 s slower per scan.
GOOGLE_VISION_KEY=
