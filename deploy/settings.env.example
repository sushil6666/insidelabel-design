# /etc/insidelabel/settings.env on the server (D-114): root:insidelabel, mode 0640.
# No secrets here: the API keys go in secrets.env. The tools (deploy/il) read this file.

# Postgres 18 on the same machine, peer auth over the local socket (no password).
INSIDELABEL_DB=postgresql:///insidelabel?host=/var/run/postgresql

# D-028/D-080: label photos, on the server disk until R2 is built.
INSIDELABEL_MEDIA=/var/lib/insidelabel/media

# D-102: only testers with an invite code can scan.
INSIDELABEL_INVITE_ONLY=on

# D-095: Caddy is the one proxy in front; the client address is read one hop
# from the right of X-Forwarded-For. Change only with the Cloudflare proxy step.
INSIDELABEL_PROXY_HOPS=1

# Invite links from tools/beta.py point here.
INSIDELABEL_PUBLIC_URL=https://insidelabel.ai

# Never set on this server:
#   INSIDELABEL_ALLOW_REPLAY     (D-101: anyone could post an invented reading)
#   INSIDELABEL_CLAIMS_TO_USERS  (D-051: the claim check stays in shadow)
#   INSIDELABEL_REVIEW_TOKEN     (D-097: reviewers log in with their own accounts)
#   INSIDELABEL_OCR              (Cloud Vision first, Tesseract only as fallback, D-093)
