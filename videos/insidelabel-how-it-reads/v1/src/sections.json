{"s1": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <div class=\"brand in\"><img src=\"assets/icon.svg\" alt=\"\" />InsideLabel</div>\n            <h1 class=\"in\">See what's inside the pack</h1>\n            <p class=\"sub in\">How we check a label, in five steps.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"pack-tilt\">\n              <div class=\"pack in\" id=\"s1-pack\">\n                <div class=\"band\"></div>\n                <div class=\"name\">Biscuits</div>\n                <div class=\"back\"><i class=\"h\"></i><i></i><i style=\"width:88%\"></i><i style=\"width:94%\"></i><i style=\"width:70%\"></i><i style=\"width:82%\"></i><i style=\"width:60%\"></i></div>\n              </div>\n            </div>\n            <svg class=\"lens\" id=\"s1-lens\" viewBox=\"0 0 300 300\" fill=\"none\">\n              <circle cx=\"125\" cy=\"125\" r=\"88\" fill=\"rgba(255,255,255,.35)\" stroke=\"#048149\" stroke-width=\"18\" />\n              <path d=\"M190 190 L268 268\" stroke=\"#048149\" stroke-width=\"26\" stroke-linecap=\"round\" />\n            </svg>\n          </div>\n        </div>", "s2": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <div class=\"step in\"><b>1</b>Step one</div>\n            <h2 class=\"in\">Photograph the back of the pack.</h2>\n            <p class=\"sub in\">The first read of a pack takes about 8 to 15 seconds.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"labelpanel in\" id=\"s2-panel\">\n              <div class=\"lh\">INGREDIENTS</div>\n              <div class=\"lt\">Wheat flour, Sugar, Edible vegetable oil (palm), Milk solids, Invert syrup, Raising agents (503(ii), 500(ii)), Salt, Colour (102), Preservative (211).</div>\n              <div class=\"frame\" id=\"s2-frame\"><span class=\"corner c1\"></span><span class=\"corner c2\"></span><span class=\"corner c3\"></span><span class=\"corner c4\"></span></div>\n              <span class=\"flash\" id=\"s2-flash\"></span>\n              <div class=\"clear\" id=\"s2-clear\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#048149\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7.5\" /></svg>\n                Photo is clear\n              </div>\n            </div>\n          </div>\n        </div>", "s3": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <div class=\"step in\"><b>2</b>Step two</div>\n            <h2 class=\"in\">An AI reads the words printed on the pack.</h2>\n            <p class=\"strong in\">It never decides anything.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"card in\">\n              <div class=\"label\">Read from the photo</div>\n              <div class=\"chips\" id=\"s3-chips\">\n                <span class=\"chip\">Wheat flour</span><span class=\"chip\">Sugar</span><span class=\"chip\">Edible vegetable oil (palm)</span>\n                <span class=\"chip\">Milk solids</span><span class=\"chip\">Invert syrup</span><span class=\"chip\">Raising agents (503(ii), 500(ii))</span>\n                <span class=\"chip\">Salt</span><span class=\"chip\">Colour (102)</span><span class=\"chip\">Preservative (211)</span>\n              </div>\n            </div>\n          </div>\n        </div>", "s4": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <div class=\"step in\"><b>3</b>Step three</div>\n            <h2 class=\"in\">A second reader checks the first.</h2>\n            <p class=\"sub in\">It reads the same photo on its own, and can only add an additive we know.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"card readcard in\">\n              <div class=\"label\">Second reader</div>\n              <div class=\"chips\" id=\"s4-chips\">\n                <span class=\"chip\">Wheat flour</span><span class=\"chip\">Sugar</span><span class=\"chip\">Edible vegetable oil (palm)</span>\n                <span class=\"chip\">Milk solids</span><span class=\"chip\">Invert syrup</span><span class=\"chip\">Raising agents (503(ii), 500(ii))</span>\n                <span class=\"chip\">Salt</span><span class=\"chip\">Colour (102)</span><span class=\"chip\">Preservative (211)</span>\n              </div>\n              <span class=\"scanline\" id=\"s4-line\"></span>\n            </div>\n          </div>\n        </div>", "s5": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <div class=\"step in\"><b>4</b>Step four</div>\n            <h2 class=\"in\">Fixed rules decide.</h2>\n            <p class=\"sub in\">Each ingredient is checked against our tables, which are checked against FSSAI's regulations.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"card in\">\n              <div class=\"label\">On the label</div>\n              <div class=\"rule-ins\">\u201cPreservative (211)\u201d</div>\n              <div class=\"rows\">\n                <div class=\"row in\"><span class=\"k\">INS 211</span><span class=\"v\">Sodium benzoate, a preservative</span></div>\n                <div class=\"row in\"><span class=\"k\">FSSAI rule</span><span class=\"v\">Numeric limits per food category (Appendix A)</span></div>\n                <div class=\"row in\"><span class=\"k\">Checked on</span><span class=\"v\">26 Sep 2026</span></div>\n              </div>\n              <div class=\"verdict\"><span class=\"pill calmpill\">Permitted in India</span></div>\n            </div>\n          </div>\n        </div>", "s6": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <div class=\"step in\"><b>5</b>Step five</div>\n            <h2 class=\"in\">Your avoid list comes first.</h2>\n            <p class=\"sub in\">We check every pack for it first and put the answer at the top of the result.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"result\">\n              <div class=\"packname in\">Sample biscuits</div>\n              <div class=\"barcard stopc in\" id=\"s6-allergen\"><div class=\"label\">You</div><p>Contains milk. It's on your avoid list.</p></div>\n              <div class=\"tile in\">\n                <span class=\"disc\">!</span>\n                <div><div class=\"t\">Tartrazine (colour 102)</div><div class=\"c\">Worth knowing</div></div>\n                <svg class=\"chev\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#244b6b\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 6l6 6-6 6\" /></svg>\n              </div>\n            </div>\n          </div>\n        </div>", "s7": "        <div class=\"wrap\">\n          <div class=\"words\">\n            <h2 class=\"in\">Hard to read? We say so.</h2>\n            <p class=\"sub in\">When the photo is hard to read, we say we can't confirm, rather than guess.</p>\n          </div>\n          <div class=\"stage\">\n            <div class=\"result\">\n              <div class=\"barcard unsurec in\" id=\"s7-card\"><div class=\"label\">You</div><p>We couldn't read the label clearly enough to check for milk. Please retake the ingredients photo.</p></div>\n              <div class=\"in\"><span class=\"btn\">Retake the ingredients photo</span></div>\n            </div>\n          </div>\n        </div>", "s8": "        <div class=\"close\">\n          <img class=\"in\" src=\"assets/icon.svg\" alt=\"\" />\n          <h1 class=\"in\">See what's inside the pack</h1>\n          <p class=\"sub in\">An AI reads. Fixed rules decide. Your avoid list comes first.</p>\n          <p class=\"url in\">insidelabel.ai</p>\n        </div>"}