{
  "_meta": {
    "table": "allergens",
    "version": "0.1",
    "purpose": "Allergen detection for avoid-list profiles (D-071). Deterministic alias matching over the ingredient list and the printed allergen_statement that prompt.py already extracts. No prompt change needed.",
    "basis": "FSS (Labelling and Display) Regulations 2020, reg. 5(14): mandatory declaration of cereals containing gluten, crustaceans, milk, eggs, fish, peanut and tree nuts, soybeans, and sulphite at 10 mg/kg or more. Cross-contact ('may contain') wording is not fixed; FSSAI's FAQ accepts any wording with similar meaning.",
    "verify": true,
    "verify_note": "Confirm the reg. 5(14) category list against the current consolidated regulation text before public launch.",
    "output_states": {
      "contains": "Found in the ingredient list or the 'contains' part of the allergen line.",
      "may_contain": "Found in a cross-contact statement ('may contain', 'traces', 'same facility', 'shared equipment').",
      "uncertain": "An ingredient could come from this allergen but the label doesn't say (e.g. lecithin with no source named).",
      "not_listed": "Not found anywhere we read. NEVER rendered as 'free from' or 'safe'.",
      "cannot_confirm": "Scan confidence below the allergen gate. We don't guess."
    },
    "rule": "Never output 'free from', 'allergen-free' or 'safe' for an allergen. The strongest negative statement allowed is 'isn't listed'.",
    "not_included": "Coconut is not in the FSSAI list and is not treated as a tree nut here. Refined oils are matched conservatively (groundnut oil counts as peanut)."
  },

  "cross_contact_triggers": [
    "may contain", "may also contain", "might contain", "can contain", "traces of", "trace of",
    "same facility", "same premises", "same plant", "same line", "shared equipment",
    "shared facility", "facility that", "facility which", "facility where",
    "manufactured in a", "processed in a", "produced in a", "packed in a",
    "made in a factory", "handles", "also processes"
  ],

